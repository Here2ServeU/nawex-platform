FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir flask kafka-python redis numpy pandas

COPY fintech/fraud_detector_service.py /app/
COPY ai/pipelines/detect_fraud.py /app/pipelines/
COPY ai/pipelines/fintech_feature_engineering.py /app/pipelines/

EXPOSE 8091

CMD ["python", "fraud_detector_service.py"]
