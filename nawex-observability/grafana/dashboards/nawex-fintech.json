{
  "uid": "nawex-fintech",
  "title": "NAWEX Fintech",
  "tags": ["nawex", "fintech"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Transaction Throughput (tx/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "datasource": { "uid": "prometheus-nawex" },
          "expr": "rate(fintech_transactions_total[5m])",
          "legendFormat": "Transactions/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Fraud Score Distribution",
      "type": "histogram",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "uid": "prometheus-nawex" },
          "expr": "sum by(le) (rate(fraud_score_bucket[5m]))",
          "legendFormat": "{{ le }}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Fraud Detection Rate (%)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 5 }] }
        }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus-nawex" },
          "expr": "100 * rate(fintech_transactions_flagged_total[5m]) / rate(fintech_transactions_total[5m])",
          "legendFormat": "Fraud Rate %"
        }
      ]
    },
    {
      "id": 4,
      "title": "Payment Gateway Latency p99 (ms)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 2000 }, { "color": "red", "value": 5000 }] }
        }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus-nawex" },
          "expr": "1000 * histogram_quantile(0.99, sum by(le) (rate(http_request_duration_seconds_bucket{job=\"fintech-payment-gateway\"}[5m])))",
          "legendFormat": "p99 ms"
        }
      ]
    },
    {
      "id": 5,
      "title": "Transaction Queue Depth",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "datasource": { "uid": "prometheus-nawex" },
          "expr": "fintech_transaction_queue_depth",
          "legendFormat": "Queue Depth"
        }
      ]
    },
    {
      "id": 6,
      "title": "Settlement Service Status",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": { "uid": "prometheus-nawex" },
          "expr": "rate(http_requests_total{job=\"fintech-payment-gateway\", status=~\"5..\"}[5m])",
          "legendFormat": "Payment Gateway Errors/s"
        },
        {
          "datasource": { "uid": "prometheus-nawex" },
          "expr": "rate(http_requests_total{job=\"fintech-transaction-engine\", status=~\"5..\"}[5m])",
          "legendFormat": "Transaction Engine Errors/s"
        }
      ]
    },
    {
      "id": 7,
      "title": "Fintech Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 8 },
      "targets": [
        {
          "datasource": { "uid": "loki-nawex" },
          "expr": "{vertical=\"fintech\"}",
          "legendFormat": ""
        }
      ]
    }
  ]
}
