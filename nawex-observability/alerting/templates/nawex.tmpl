{{ define "nawex.title" -}}
[{{ .Status | toUpper }}{{ if eq .Status "firing" }}:{{ .Alerts.Firing | len }}{{ end }}]
{{- if .CommonLabels.vertical }} [{{ .CommonLabels.vertical | toUpper }}]{{ end }}
{{ .CommonLabels.alertname }}
{{- end }}

{{ define "nawex.text" -}}
{{ if gt (len .Alerts.Firing) 0 -}}
*Firing Alerts ({{ .Alerts.Firing | len }}):*
{{ range .Alerts.Firing }}
  • *{{ .Labels.alertname }}* — {{ .Annotations.summary }}
    {{ if .Annotations.description }}{{ .Annotations.description }}{{ end }}
    Severity: `{{ .Labels.severity }}` | Job: `{{ .Labels.job }}`
{{ end }}
{{- end }}
{{ if gt (len .Alerts.Resolved) 0 -}}
*Resolved ({{ .Alerts.Resolved | len }}):*
{{ range .Alerts.Resolved }}
  ✓ *{{ .Labels.alertname }}* resolved
{{ end }}
{{- end }}
{{- end }}

{{ define "nawex.email.subject" -}}
[NAWEX {{ .Status | toUpper }}] {{ .CommonLabels.alertname }}
{{- end }}

{{ define "nawex.email.body" -}}
<!DOCTYPE html>
<html>
<body style="font-family: Arial, sans-serif; color: #333;">
  <h2 style="color: {{ if eq .Status "firing" }}#d32f2f{{ else }}#388e3c{{ end }};">
    NAWEX Platform Alert — {{ .Status | toUpper }}
  </h2>
  <table border="0" cellpadding="6" style="border-collapse:collapse; width:100%;">
    <tr><th align="left">Alert</th><th align="left">Summary</th><th align="left">Severity</th></tr>
    {{ range .Alerts }}
    <tr>
      <td>{{ .Labels.alertname }}</td>
      <td>{{ .Annotations.summary }}</td>
      <td>{{ .Labels.severity }}</td>
    </tr>
    {{ end }}
  </table>
  <p style="color:#666; font-size:12px;">NAWEX Platform Observability — {{ .CommonLabels.environment }}</p>
</body>
</html>
{{- end }}
