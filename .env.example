# Copy to .env for `make up` (docker compose reads it). Never commit .env.
GOLDEN_ENV=local
GOLDEN_LOG_LEVEL=INFO

# --- AI safety
GOLDEN_AUTONOMY_MODE=dry_run          # dry_run | supervised | autonomous
GOLDEN_KILL_SWITCH=false
GOLDEN_MAX_ACTIONS_PER_HOUR=20
GOLDEN_API_KEYS=                      # comma-separated; empty disables auth (local only!)
GOLDEN_RATE_LIMIT_PER_MINUTE=600

# --- Models / GPU
GOLDEN_MODEL_DIR=models
GOLDEN_DEVICE=auto                    # auto | cuda | mps | cpu
GOLDEN_AMP=true
GOLDEN_COMPILE=false

# --- UI
PLATFORM_NAME=Golden Platform
