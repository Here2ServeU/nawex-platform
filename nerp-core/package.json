    "robotics:start": "scripts/start_robotics.sh",
    "fintech:start": "scripts/start_fintech.sh",
    "fintech:traffic": "scripts/generate-transactions.sh",
    "healthcare:start": "scripts/start_healthcare.sh",
    "healthcare:traffic": "scripts/generate-ehr-events.sh",
