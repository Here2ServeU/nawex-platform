# ---------------------------------------------------------------------------------------
# COMPREHENSIVE GIT IGNORE FILE
# Generated for multi-cloud, multi-tooling (Node, Terraform, Helm, Kubernetes) environment
# ---------------------------------------------------------------------------------------

# -------------------------------------------------------------
# 1. NODE / NPM
# -------------------------------------------------------------
node_modules/
/npm-debug.log
.npm/
.eslintcache
/pids
/logs
# Runtime and environment data
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
/coverage
/dist

# -------------------------------------------------------------
# 2. OS / IDE EXCLUSIONS
# -------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# -------------------------------------------------------------
# 3. TERRAFORM (Updated for multi-dir structure and cache)
# -------------------------------------------------------------
# Ignore all local Terraform working directories (cache in any subdirectory)
**/.terraform/
**/.terraform.lock.hcl

# Ignore state files globally (ensures secrets and current state are not committed)
**/*.tfstate
**/*.tfstate.backup

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files (sensitive local secrets)
*.tfvars
*.tfvars.json

# Terraform CLI config history
.terraformrc

# -------------------------------------------------------------
# 4. HELM AND KUBERNETES TOOLING
# -------------------------------------------------------------
# Helm Chart dependency cache (e.g., helm/backstage/charts/)
**/charts/
**/*.tgz
# Kustomize build output
kustomize/
# Kubernetes configuration files (local secrets)
kubeconfig
.kube/

# -------------------------------------------------------------
# 5. BINARY, SCRIPT & BUILD ARTIFACTS
# -------------------------------------------------------------
# General compiled files
*.exe
*.dll
*.so
*.o
*.a
*.obj
# Go binaries and build directories
*.bin
/pkg/
# Custom temporary files from scripts
tmp/
