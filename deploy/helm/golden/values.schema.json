{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "golden chart values",
  "type": "object",
  "required": [
    "image",
    "platform",
    "services"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [],
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "registry": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "platform": {
      "type": "object",
      "properties": {
        "autonomyMode": {
          "type": "string",
          "enum": [
            "dry_run",
            "supervised",
            "autonomous"
          ]
        },
        "killSwitch": {
          "type": "boolean"
        },
        "logLevel": {
          "type": "string"
        }
      }
    },
    "apiKeys": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "type": "boolean"
        },
        "create": {
          "type": "boolean"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "port"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "replicaCount": {
            "type": "integer",
            "minimum": 0
          },
          "gpu": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "rollout": {
            "$ref": "#/definitions/rollout"
          },
          "keda": {
            "$ref": "#/definitions/keda"
          }
        }
      }
    },
    "gpu": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "rollout": {
          "$ref": "#/definitions/rollout"
        },
        "keda": {
          "$ref": "#/definitions/keda"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "prometheusAddress": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "rollouts": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "canary": {
          "type": "object",
          "properties": {
            "maxSurge": {
              "type": [
                "string",
                "integer"
              ]
            },
            "maxUnavailable": {
              "type": [
                "string",
                "integer"
              ]
            },
            "abortScaleDownDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object"
              }
            }
          }
        },
        "analysis": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(s|m|h)$"
            },
            "failureLimit": {
              "type": "integer",
              "minimum": 0
            },
            "consecutiveErrorLimit": {
              "type": "integer",
              "minimum": 0
            },
            "minSuccessRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maxP95LatencySeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "selectCanaryPods": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiVersion": {
          "type": "string",
          "enum": [
            "external-secrets.io/v1beta1",
            "external-secrets.io/v1"
          ]
        },
        "refreshInterval": {
          "type": "string"
        },
        "secretStoreRef": {
          "$ref": "#/definitions/secretStoreRef"
        },
        "secrets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "targetName": {
                "type": "string"
              },
              "refreshInterval": {
                "type": "string"
              },
              "secretStoreRef": {
                "$ref": "#/definitions/secretStoreRef"
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "secretKey",
                    "remoteRef"
                  ]
                }
              },
              "dataFrom": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "definitions": {
    "rollout": {
      "type": "object",
      "description": "Per-service Argo Rollouts settings (active only when rollouts.enabled).",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "trafficRouting": {
          "type": "object"
        },
        "maxSurge": {
          "type": [
            "string",
            "integer"
          ]
        },
        "maxUnavailable": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "additionalProperties": false
    },
    "keda": {
      "type": "object",
      "description": "Per-service KEDA ScaledObject (replaces the HPA).",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxReplicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "pollingInterval": {
          "type": "integer",
          "minimum": 1
        },
        "cooldownPeriod": {
          "type": "integer",
          "minimum": 0
        },
        "requestsPerSecondThreshold": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "query": {
          "type": "string"
        },
        "extraTriggers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "secretStoreRef": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "SecretStore",
            "ClusterSecretStore"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
