# Copy to terraform.tfvars and adjust. Every live/<cloud>/<env> accepts the same variables.
project            = "golden"
environment        = "prod"
region             = "us-east-1"
kubernetes_version = "1.31"
node_count         = 3
node_instance_type = "m6i.xlarge"

# GPU / AI-infrastructure node pool for gpu-optimizer
gpu_node_pool_enabled = false
gpu_instance_type     = "g5.xlarge"
gpu_node_count        = 1

tags = {
  owner       = "platform-engineering"
  cost_center = "REPLACE_ME"
}

# Who may reach the Kubernetes API server. Use your VPN / office egress CIDRs
# (e.g. ["203.0.113.0/24"]), or leave empty for a private-only endpoint and run
# deploys from a self-hosted runner / bastion inside the VPC / VNet.
# 0.0.0.0/0 is rejected.
api_server_authorized_cidrs = []
