# Copy to backend.hcl and run: terraform init -backend-config=backend.hcl
# State for the org-level identity stack lives in the management (or delegated admin) account.
bucket         = "REPLACE_ME-golden-tfstate"
key            = "golden/org/identity.tfstate"
region         = "us-east-1"
dynamodb_table = "golden-terraform-locks"
encrypt        = true
