# Copy to terraform.tfvars and adjust. Every live/<cloud>/<env> accepts the same variables.
project            = "golden"
environment        = "dev"
region             = "us-central1"
project_id         = "REPLACE_ME-gcp-project"
kubernetes_version = "1.30"
node_count         = 2
node_instance_type = "e2-standard-4"

# GPU / AI-infrastructure node pool for gpu-optimizer
gpu_node_pool_enabled = false
gpu_instance_type     = "n1-standard-4"
gpu_node_count        = 1

tags = {
  owner       = "platform-engineering"
  cost_center = "REPLACE_ME"
}
