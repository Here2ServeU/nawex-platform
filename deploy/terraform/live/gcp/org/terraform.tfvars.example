# Copy to terraform.tfvars and adjust. Applied once per organization.
org_id        = "123456789012"
customer_id   = "C0REPLACEME"
quota_project = "golden-seed-REPLACE_ME"
domain        = "example.com"

allowed_locations = ["in:us-locations"]

# Staged rollout: dry-run first where the constraint supports it, then enforce.
dry_run_constraints = []

pam_approvers = ["group:gcp-pam-approvers@example.com"]

deny_exception_principals = [
  "principal://iam.googleapis.com/projects/-/serviceAccounts/golden-terraform@golden-seed-REPLACE_ME.iam.gserviceaccount.com",
]
