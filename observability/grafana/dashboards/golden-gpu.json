{
  "uid": "golden-gpu",
  "title": "Golden Platform — GPU / AI Infrastructure",
  "tags": [
    "golden",
    "gpu",
    "finops"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-golden"
        },
        "query": {
          "query": "label_values(golden_gpu_utilization_ratio, node)",
          "refId": "node"
        },
        "definition": "label_values(golden_gpu_utilization_ratio, node)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "GPU Optimizer Up",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "max(up{job=\"gpu\", instance=~\"gpu-optimizer:.*\"})",
          "legendFormat": "up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Fleet Avg Utilization",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "avg(golden_gpu_utilization_ratio{node=~\"$node\"})",
          "legendFormat": "avg"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.2
              },
              {
                "color": "green",
                "value": 0.6
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Idle GPUs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "max(golden_gpu_idle_gpus)",
          "legendFormat": "idle"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Projected Monthly Savings",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "max(golden_gpu_projected_monthly_savings_usd)",
          "legendFormat": "USD / month"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Hottest GPU",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "max(golden_gpu_temperature_celsius{node=~\"$node\"})",
          "legendFormat": "max °C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "GPU Utilization by Device",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "golden_gpu_utilization_ratio{node=~\"$node\"}",
          "legendFormat": "{{node}}/{{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "GPU Temperature by Device",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "golden_gpu_temperature_celsius{node=~\"$node\"}",
          "legendFormat": "{{node}}/{{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Underutilized GPUs (< 20%, 1h avg)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "avg_over_time(golden_gpu_utilization_ratio{node=~\"$node\"}[1h]) < 0.2",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Candidates for rightsizing, MIG partitioning, bin-packing or idle reclamation."
    },
    {
      "id": 9,
      "title": "Idle GPUs & Projected Savings",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "max(golden_gpu_idle_gpus)",
          "legendFormat": "idle GPUs"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "B",
          "expr": "max(golden_gpu_projected_monthly_savings_usd)",
          "legendFormat": "projected savings (USD/mo)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "projected savings (USD/mo)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "description": "Right axis: projected monthly savings."
    },
    {
      "id": 10,
      "title": "DCGM — SM Utilization (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "legendFormat": "{{Hostname}}/{{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "description": "NVIDIA DCGM exporter (real clusters only)."
    },
    {
      "id": 11,
      "title": "DCGM — Framebuffer Used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "DCGM_FI_DEV_FB_USED",
          "legendFormat": "{{Hostname}}/{{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "DCGM — Power Usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "DCGM_FI_DEV_POWER_USAGE",
          "legendFormat": "{{Hostname}}/{{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "DCGM — XID Errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "DCGM_FI_DEV_XID_ERRORS > 0",
          "legendFormat": "{{Hostname}}/{{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "GPU Optimizer API Latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le, path) (rate(golden_http_request_duration_seconds_bucket{service=\"gpu-optimizer\"}[5m])))",
          "legendFormat": "{{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
