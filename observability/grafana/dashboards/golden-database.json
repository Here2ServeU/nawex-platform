{
  "uid": "golden-database",
  "title": "Golden Platform — Database Performance (PostgreSQL)",
  "description": "postgres_exporter + pgbouncer-exporter. Rules: observability/prometheus/rules/database_rules.yml. Runbook: ops/runbooks/playbooks/database_performance.md",
  "tags": [
    "golden",
    "database",
    "postgresql"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-golden"
        },
        "query": {
          "query": "label_values(pg_up, instance)",
          "refId": "instance"
        },
        "definition": "label_values(pg_up, instance)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "datname",
        "label": "Database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-golden"
        },
        "query": {
          "query": "label_values(pg_stat_database_xact_commit{instance=~\"$instance\"}, datname)",
          "refId": "datname"
        },
        "definition": "label_values(pg_stat_database_xact_commit{instance=~\"$instance\"}, datname)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Exporter Up",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "min(pg_up{instance=~\"$instance\"})",
          "legendFormat": "up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Connection Saturation",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "max(pg:connections:saturation{instance=~\"$instance\"})",
          "legendFormat": "used / max_connections"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "pg_stat_activity_count / pg_settings_max_connections (alert > 0.8)."
    },
    {
      "id": 3,
      "title": "Cache Hit Ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "min(pg:cache_hit:ratio{instance=~\"$instance\", datname=~\"$datname\"})",
          "legendFormat": "hit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "title": "Transactions / s",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum(pg:transactions:rate5m{instance=~\"$instance\", datname=~\"$datname\"})",
          "legendFormat": "tps"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "title": "Deadlocks (1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum(increase(pg_stat_database_deadlocks{instance=~\"$instance\", datname=~\"$datname\"}[1h]))",
          "legendFormat": "deadlocks"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "XID Wraparound",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "max(pg_database_wraparound_ratio{instance=~\"$instance\", datname=~\"$datname\"})",
          "legendFormat": "of 2^31"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.75
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "age(datfrozenxid) / 2^31 (alerts at 50 % and 75 %)."
    },
    {
      "id": 7,
      "title": "Throughput (QPS / TPS)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum by (datname) (pg:transactions:rate5m{instance=~\"$instance\", datname=~\"$datname\"})",
          "legendFormat": "TPS {{datname}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "B",
          "expr": "sum by (datname) (pg:statements:calls_rate5m{instance=~\"$instance\", datname=~\"$datname\"})",
          "legendFormat": "statements/s {{datname}} (top 20)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "description": "Transactions from pg_stat_database; statement calls from the pg_stat_statements top-20 custom query."
    },
    {
      "id": 8,
      "title": "Statement Mean Latency (top 10)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "topk(10, pg:statement_mean_latency_seconds:rate5m{instance=~\"$instance\", datname=~\"$datname\"})",
          "legendFormat": "{{queryid}} {{query}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "rate(total_exec_time) / rate(calls) per pg_stat_statements queryid."
    },
    {
      "id": 9,
      "title": "Connections by State",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum by (state) (pg_stat_activity_count{instance=~\"$instance\", datname=~\"$datname\"})",
          "legendFormat": "{{state}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "B",
          "expr": "max(pg_settings_max_connections{instance=~\"$instance\"})",
          "legendFormat": "max_connections"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max_connections"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "title": "Cache Hit Ratio over Time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "pg:cache_hit:ratio{instance=~\"$instance\", datname=~\"$datname\"}",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Replication Lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "max by (instance) (pg_replication_lag_seconds{instance=~\"$instance\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Streaming replicas. Aurora readers report AuroraReplicaLag in CloudWatch instead."
    },
    {
      "id": 12,
      "title": "Locks & Blocked Sessions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum by (mode) (pg_locks_count{instance=~\"$instance\", datname=~\"$datname\"})",
          "legendFormat": "{{mode}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "B",
          "expr": "max(pg_blocked_sessions_count{instance=~\"$instance\"})",
          "legendFormat": "blocked sessions"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Deadlocks & Long Transactions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum by (datname) (increase(pg_stat_database_deadlocks{instance=~\"$instance\", datname=~\"$datname\"}[5m]))",
          "legendFormat": "deadlocks {{datname}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "B",
          "expr": "max(pg_long_running_transactions_max_age_seconds{instance=~\"$instance\"})",
          "legendFormat": "oldest txn age (s)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "C",
          "expr": "max(pg_long_running_transactions_idle_in_transaction{instance=~\"$instance\"})",
          "legendFormat": "idle in transaction"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Dead Tuple Ratio (top 10 tables)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "topk(10, pg:dead_tuple:ratio{instance=~\"$instance\", datname=~\"$datname\"})",
          "legendFormat": "{{relname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Temp Bytes Written",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum by (datname) (rate(pg_stat_database_temp_bytes{instance=~\"$instance\", datname=~\"$datname\"}[5m]))",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "description": "Sorts and hashes spilling past work_mem."
    },
    {
      "id": 16,
      "title": "PgBouncer Pools",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum by (database) (pgbouncer_pools_client_active_connections)",
          "legendFormat": "active clients {{database}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "B",
          "expr": "sum by (database) (pgbouncer_pools_client_waiting_connections)",
          "legendFormat": "waiting clients {{database}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "C",
          "expr": "sum by (database) (pgbouncer_pools_server_active_connections)",
          "legendFormat": "server conns {{database}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 17,
      "title": "Top Queries (pg_stat_statements)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "topk(20, sum by (queryid, query) (rate(pg_stat_statements_top_total_exec_time_seconds{instance=~\"$instance\", datname=~\"$datname\"}[$__rate_interval])))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "B",
          "expr": "sum by (queryid, query) (rate(pg_stat_statements_top_calls{instance=~\"$instance\", datname=~\"$datname\"}[$__rate_interval]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "C",
          "expr": "sum by (queryid, query) (pg:statement_mean_latency_seconds:rate5m{instance=~\"$instance\", datname=~\"$datname\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "D",
          "expr": "sum by (queryid, query) (rate(pg_stat_statements_top_shared_blks_read{instance=~\"$instance\", datname=~\"$datname\"}[$__rate_interval]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Database time per second by statement; feed the worst queryid to `golden db explain`.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "exec time (s/s)",
              "Value #B": "calls/s",
              "Value #C": "mean latency (s)",
              "Value #D": "blocks read/s"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "exec time (s/s)",
                "desc": true
              }
            ]
          }
        }
      ]
    }
  ]
}
