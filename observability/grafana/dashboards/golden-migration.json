{
  "uid": "golden-migration",
  "title": "Golden Platform — VM Migration (VMware → OpenShift)",
  "tags": [
    "golden",
    "migration",
    "modernization"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "wave",
        "label": "Wave",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-golden"
        },
        "query": {
          "query": "label_values(golden_migration_wave_progress_ratio, wave)",
          "refId": "wave"
        },
        "definition": "label_values(golden_migration_wave_progress_ratio, wave)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Migration Planner Up",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "max(up{job=\"migration\"})",
          "legendFormat": "up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "VMs Migrated",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum(golden_migration_vms_total{status=~\"succeeded|completed\"})",
          "legendFormat": "migrated"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "VMs Failed",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum(golden_migration_vms_total{status=~\"failed|error\"})",
          "legendFormat": "failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Failure Ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "migration:vms_failed:ratio",
          "legendFormat": "failed %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Per-VM Duration p95",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "migration:duration_seconds:p95",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Wave Progress",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "golden_migration_wave_progress_ratio{wave=~\"$wave\"}",
          "legendFormat": "wave {{wave}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "VMs by Status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum by(status) (golden_migration_vms_total)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Failures by Reason (rate)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum by(reason) (increase(golden_migration_failures_total[15m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "e.g. vddk_timeout, storage_capacity, network_mapping, guest_conversion, precopy_error"
    },
    {
      "id": 9,
      "title": "Per-VM Migration Duration (p50/p95/p99)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by(le) (rate(golden_migration_duration_seconds_bucket[1h])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(golden_migration_duration_seconds_bucket[1h])))",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by(le) (rate(golden_migration_duration_seconds_bucket[1h])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Migration Planner API Requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum by(path, status) (rate(golden_http_requests_total{service=\"migration-planner\"}[5m]))",
          "legendFormat": "{{path}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Firing Migration Alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\", vertical=\"migration\"}",
          "legendFormat": "{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
