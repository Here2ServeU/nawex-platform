{
  "uid": "golden-ai-safety",
  "title": "Golden Platform — AI Safety",
  "tags": [
    "golden",
    "security",
    "ai-safety"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-golden"
        },
        "query": {
          "query": "label_values(golden_http_requests_total, service)",
          "refId": "service"
        },
        "definition": "label_values(golden_http_requests_total, service)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Kill Switch",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "max(golden_kill_switch_engaged)",
          "legendFormat": "kill switch"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "RELEASED",
                  "color": "green"
                },
                "1": {
                  "text": "ENGAGED",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "description": "GOLDEN_KILL_SWITCH — when engaged, every autonomous action is refused."
    },
    {
      "id": 2,
      "title": "Guardrail Rejections (1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum(increase(golden_guardrail_rejections_total{service=~\"$service\"}[1h]))",
          "legendFormat": "rejections"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Actions Blocked (1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum(increase(golden_actions_blocked_total[1h]))",
          "legendFormat": "blocked"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Rate-limited Requests (1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum(increase(golden_rate_limited_total{service=~\"$service\"}[1h]))",
          "legendFormat": "rate limited"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Guardrail Rejections by Reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum by(service, reason) (rate(golden_guardrail_rejections_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}} · {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "description": "Input caps, schema / range violations, out-of-distribution and adversarial-pattern rejections."
    },
    {
      "id": 6,
      "title": "Actions Blocked by Reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum by(reason) (rate(golden_actions_blocked_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "description": "Action budget exhausted, approval required, kill switch, dry-run mode."
    },
    {
      "id": 7,
      "title": "Rate Limited by Service",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum by(service) (rate(golden_rate_limited_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Auth Failures (401/403) by Service",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "sum by(service, status) (rate(golden_http_requests_total{service=~\"$service\", status=~\"401|403\"}[5m]))",
          "legendFormat": "{{service}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Fraud Score p95 (model output drift)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(golden_fraud_score_bucket[5m])))",
          "legendFormat": "fraud p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by(le) (rate(golden_fraud_score_bucket[5m])))",
          "legendFormat": "fraud p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "description": "Sudden shifts can indicate data poisoning, drift or input manipulation."
    },
    {
      "id": 10,
      "title": "PHI Risk Score p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(golden_phi_risk_score_bucket[5m])))",
          "legendFormat": "PHI risk p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.7
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Firing AI-safety Alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-golden"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-golden"
          },
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\", domain=\"ai-safety\"}",
          "legendFormat": "{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
