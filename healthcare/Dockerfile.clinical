FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir flask kafka-python redis numpy pandas

COPY healthcare/clinical_decision_service.py /app/
COPY ai/pipelines/detect_phi_anomalies.py /app/pipelines/
COPY ai/pipelines/healthcare_feature_engineering.py /app/pipelines/

EXPOSE 8094

CMD ["python", "clinical_decision_service.py"]
